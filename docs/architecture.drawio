<mxfile host="app.diagrams.net" agent="ask-my-docs" type="device">
  <diagram name="Ask My Docs pipeline" id="ask-my-docs-architecture">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Ask My Docs — retrieval-augmented generation over personal notes" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F2A44;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Built stage by stage, no RAG framework. Ingestion runs once per change to the notes; the query side runs per question." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="60" y="48" width="980" height="20" as="geometry" />
        </mxCell>

        <!-- ================= INGESTION ================= -->
        <mxCell id="ingest-box" value="INGESTION — runs once per change to your notes" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#F7F9FB;strokeColor=#1C4E7A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#1C4E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="420" height="700" as="geometry" />
        </mxCell>

        <mxCell id="notes" value="sample-notes/&#10;&#10;5 markdown files&#10;79,581 characters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F7;strokeColor=#1C4E7A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="130" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="loader" value="loader.py&#10;&#10;read .md .txt .pdf&#10;keep filename and page number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C4E7A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="250" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="chunker" value="chunker.py&#10;&#10;350 characters, 70 overlap&#10;cut at sentence boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C4E7A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="370" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="embed-ingest" value="embedder.py&#10;&#10;all-MiniLM-L6-v2, runs locally&#10;384 numbers per chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E8B84;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="store" value="store.py — Chroma&#10;317 chunks on disk&#10;cosine distance" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#FDF4E6;strokeColor=#B56E0C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="620" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C4E7A;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="notes" target="loader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C4E7A;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="loader" target="chunker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C4E7A;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="chunker" target="embed-ingest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C4E7A;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="embed-ingest" target="store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= QUERY ================= -->
        <mxCell id="query-box" value="QUERY — runs once per question" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#F7F9FB;strokeColor=#2E8B84;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#2E8B84;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="420" height="700" as="geometry" />
        </mxCell>

        <mxCell id="question" value="your question&#10;&#10;&quot;what is a context window measured in?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F7;strokeColor=#2E8B84;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="130" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="embed-query" value="embedder.py&#10;&#10;THE SAME MODEL as ingestion&#10;384 numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E8B84;fontSize=12;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="690" y="250" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="retriever" value="retriever.py&#10;&#10;top 5 nearest chunks&#10;converts distance to similarity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8B84;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="370" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="generator" value="generator.py&#10;&#10;numbers the passages [1]–[5]&#10;and permits the model to refuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8B84;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="490" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="chat model&#10;gemini-3.5-flash-lite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4E6;strokeColor=#B56E0C;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="610" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="answer" value="answer + citations&#10;&quot;A context window is measured in tokens [1][3]&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E8B84;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="690" y="700" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B84;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="question" target="embed-query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B84;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="embed-query" target="retriever">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B84;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="retriever" target="generator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B84;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="generator" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B84;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="llm" target="answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross link: the store answers the retriever -->
        <mxCell id="search" value="similarity search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#B56E0C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B56E0C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="store" target="retriever">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Log -->
        <mxCell id="log" value="logs/retrieval.log&#10;question, settings, scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#6B7280;fontSize=11;fontColor=#6B7280;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="375" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- Key invariant callout -->
        <mxCell id="note" value="The embedding model appears on BOTH sides and must be the same one.&#10;Embeddings from two different models are not comparable, and comparing them&#10;raises no error — it returns confident nonsense. The store records which model&#10;built it and refuses a mismatch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B56E0C;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="980" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
