<mxfile host="app.diagrams.net" agent="ask-my-docs" type="device">
  <diagram name="Ask My Docs - one question, end to end" id="ask-my-docs-architecture">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="Ask My Docs - one question, end to end" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The model never sees my notes. It sees five passages retrieval chose, and it is told to refuse if they do not contain the answer." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="72" width="1100" height="24" as="geometry" />
        </mxCell>

        <!-- ============ INGESTION, to one side ============ -->
        <mxCell id="ingest-box" value="INGESTION - runs once, and again whenever the notes change" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#999999;verticalAlign=top;align=center;spacingTop=8;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="300" height="640" as="geometry" />
        </mxCell>

        <mxCell id="notes" value="sample-notes/&#10;5 markdown files, 79,581 chars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="loader.py&#10;read .md .txt .pdf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="chunker" value="chunker.py&#10;350 chars, 70 overlap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="embed-ingest" value="embedder.py&#10;317 chunks x 384 numbers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="store" value="store.py - Chroma&#10;on disk, cosine distance" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="115" y="620" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="i1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="notes" target="loader"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="loader" target="chunker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="chunker" target="embed-ingest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="embed-ingest" target="store"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ CENTRE SPINE: the query ============ -->
        <mxCell id="ask" value="I ask a question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="embed-query" value="embedder.py&#10;&lt;i&gt;the same model that built the index&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="310" width="300" height="65" as="geometry" />
        </mxCell>

        <mxCell id="retriever" value="retriever.py&#10;top 5 nearest chunks&#10;&lt;font face=&quot;Courier New&quot;&gt;similarity = 1 - distance&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="430" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Did anything&#10;relevant come back?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="565" y="565" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="prompt" value="&lt;b&gt;Build the prompt&lt;/b&gt;&#10;passages numbered &lt;font face=&quot;Courier New&quot;&gt;[1]&lt;/font&gt; to &lt;font face=&quot;Courier New&quot;&gt;[5]&lt;/font&gt;&#10;&lt;b&gt;answer ONLY from these&lt;/b&gt;&#10;and say so if they do not contain it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="730" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="Gemini API&#10;&lt;i&gt;gemini-3.5-flash-lite&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="900" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="reply" value="Answer text&#10;&lt;font face=&quot;Courier New&quot;&gt;+ which passages it cited&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="1010" width="300" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sources" value="Resolve &lt;font face=&quot;Courier New&quot;&gt;[1]&lt;/font&gt; back to&#10;&lt;font face=&quot;Courier New&quot;&gt;project1-learnings.md#26&lt;/font&gt;&#10;with its similarity score" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="1125" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="out" value="Print the answer and its sources" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="1255" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- spine edges -->
        <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="ask" target="embed-query"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="embed-query" target="retriever"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="retriever" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="decision" target="prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="prompt" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6" value="answer" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="llm" target="reply"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="reply" target="sources"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="sources" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- store feeds the retriever -->
        <mxCell id="search" value="similarity search" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d6b656;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#b56e0c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="store" target="retriever"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ REFUSAL PATH ============ -->
        <mxCell id="refuse" value="&lt;b&gt;Say so, do not invent&lt;/b&gt;&#10;&#10;&quot;I can't find the answer&#10;to that in your notes.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="990" y="560" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="s-no" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="decision" target="refuse"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="refuse-note" value="Measured: a question my notes cannot answer still&#10;scored 0.339, while the weakest real answer scored&#10;0.366. A 0.027 gap, so no score cut-off is safe.&#10;The prompt has to carry this, not a threshold." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="990" y="690" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- ============ SIDE ANNOTATIONS ============ -->
        <mxCell id="trick" value="This is the whole trick.&#10;The model is given the passages&#10;and told to use nothing else -&#10;including nothing it already knows." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#b56e0c;" vertex="1" parent="1">
          <mxGeometry x="900" y="820" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="same-model-note" value="The same model must embed both sides.&#10;Numbers from two different models are not&#10;comparable, and mixing them raises no error -&#10;it returns confident nonsense. The store records&#10;which model built it and refuses a mismatch." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="880" y="290" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="citation-note" value="Numbering the passages is what makes&#10;citation possible. Asking the model to&#10;&quot;say which files you used&quot; gets a vague&#10;gesture at all five." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="880" y="1130" width="330" height="80" as="geometry" />
        </mxCell>

        <!-- ============ LOG ============ -->
        <mxCell id="log" value="logs/retrieval.log&#10;&lt;i&gt;question, settings, every score&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="900" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s-log" value="logged" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#999999;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="retriever" target="log"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ RE-INGEST LOOP ============ -->
        <mxCell id="reingest" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 8;strokeColor=#999999;strokeWidth=1.5;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="out" target="notes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="40" y="1285" /><mxPoint x="40" y="170" /><mxPoint x="210" y="170" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="reingest-note" value="Add or edit a note, re-run ingestion.&#10;Nothing else changes." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="300" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
