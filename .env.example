# Copy this file to .env and fill in your values.
# .env is gitignored - never commit real keys.

# ---- Embedding backend ----
# "local"  = Sentence Transformers, runs on your machine, free, no key needed
# "openai" = OpenAI Embeddings API, needs OPENAI_API_KEY below
EMBEDDING_BACKEND=local

# Model used when EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model used when EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Chunking ----
# Chosen in Week 1 by measuring six size/overlap pairs. 500 held a complete
# thought without dragging in an unrelated table; 100 of overlap rescued a fact
# that a hard 500-character cut had split in half.
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ---- Retrieval ----
# Chosen in Week 2 by comparing k of 3, 5 and 10. k=10 cost 3.4x the context for
# a 0.06 drop in mean relevance and wasted 3 slots on duplicate neighbouring
# chunks; k=3 pulled from too few sources. See notes/week2-learning-log.md.
TOP_K=5

# Similarity floor, 0.0-1.0. Deliberately left empty: measured across four
# questions, any floor high enough to reject an unanswerable question also
# stripped real answers from the weaker ones. Week 3 relies on the prompt
# allowing the model to refuse instead.
MIN_SCORE=

# ---- LLM for answer generation (needed in Week 3, not Week 1) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
